{
  "name": "bug-clinic-wordpress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "broken": "node scripts/run.mjs broken",
    "fixed": "node scripts/run.mjs fixed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:php": "node scripts/lint-php.mjs",
    "test": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.mjs",
    "prebroken": "npm run build",
    "prefixed": "npm run build",
    "pretest": "npm run build",
    "prescreenshots": "npm run build"
  },
  "devDependencies": {
    "@wp-playground/cli": "3.1.62",
    "@playwright/test": "1.64.1",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
