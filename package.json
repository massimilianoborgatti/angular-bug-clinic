{
  "name": "angular-bug-clinic",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "build:pages": "ng build --base-href /angular-bug-clinic/",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:pages": "playwright test --config playwright.pages.config.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "verify": "npm run lint && npm test && npm run e2e && npm run build:pages"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@playwright/test": "^1.58.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "description": "Five small Angular and Ionic debugging case studies.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
