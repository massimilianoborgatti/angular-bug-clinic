    "e2e:integration": "playwright test --config playwright.integration.config.ts",
    "prebuild": "node scripts/prepare-worker.mjs",
    "predev": "node scripts/prepare-worker.mjs",
    "performance": "node scripts/measure-vitals.mjs",
