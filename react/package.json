    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.0.0",
    "lighthouse": "13.6.0",
    "prettier": "^3.8.1",
    "sharp": "0.35.5",
    "typescript": "~6.0.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
